---
const projects = [
  {
    title: "Data Engineering Pipeline",
    description:
      "Designed an end-to-end data pipeline for extracting, transforming and loading structured data into an analytics-ready environment.",
    technologies: ["Python", "SQL", "ETL", "Data Warehousing"],
  },
  {
    title: "SQL Analytics Platform",
    description:
      "Built analytical SQL workflows to transform raw business data into meaningful reporting metrics and decision-ready insights.",
    technologies: ["SQL", "Python", "Analytics", "BI"],
  },
  {
    title: "Data Analytics Dashboard",
    description:
      "Created a dashboard-focused analytics solution for exploring KPIs, trends and operational performance.",
    technologies: ["Power BI", "SQL", "Data Modeling"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Chetan Mylapilli — Data Engineer and SQL Developer portfolio."
    />
    <title>Chetan Mylapilli | Data Engineer</title>
  </head>

  <body>
    <header class="navbar">
      <div class="container nav-inner">
        <a href="/" class="logo">Chetan<span>.</span></a>

        <nav>
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-content">
            <p class="eyebrow">DATA ENGINEER · SQL DEVELOPER</p>

            <h1>
              Building data systems that
              <span>turn data into insight.</span>
            </h1>

            <p class="hero-description">
              I design data pipelines, analytical workflows and data-driven
              solutions using SQL, Python, ETL and modern data technologies.
            </p>

            <div class="hero-buttons">
              <a href="#projects" class="button primary">
                View Projects →
              </a>

              <a href="#contact" class="button secondary">
                Contact Me
              </a>
            </div>

            <div class="tech-row">
              <span>SQL</span>
              <span>Python</span>
              <span>ETL</span>
              <span>Data Warehousing</span>
              <span>Analytics</span>
            </div>
          </div>

          <div class="hero-card">
            <div class="terminal-header">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="terminal-body">
              <p><span class="purple">SELECT</span> skills</p>
              <p><span class="purple">FROM</span> data_engineer</p>
              <p><span class="purple">WHERE</span> passion = <span class="green">true</span>;</p>

              <br />

              <p class="comment">-- Result</p>

              <p class="result">
                pipelines ✓
              </p>

              <p class="result">
                analytics ✓
              </p>

              <p class="result">
                scalable_data ✓
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="section">
        <div class="container two-column">
          <div>
            <p class="section-label">01 / ABOUT</p>
            <h2>Data with purpose.</h2>
          </div>

          <div class="about-text">
            <p>
              I'm Chetan Mylapilli, a data-focused technology professional
              interested in building reliable systems that transform raw data
              into useful information.
            </p>

            <p>
              My work focuses on SQL, data engineering, ETL, analytics,
              databases and building practical solutions around real-world
              datasets.
            </p>

            <p>
              This portfolio showcases selected projects, technical work and
              the technologies I use to solve data problems.
            </p>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->
      <section id="projects" class="section projects-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-label">02 / PROJECTS</p>
              <h2>Selected work.</h2>
            </div>

            <p>
              A selection of projects demonstrating data engineering,
              analytics and SQL development.
            </p>
          </div>

          <div class="project-grid">
            {
              projects.map((project, index) => (
                <article class="project-card">
                  <div class="project-number">
                    0{index + 1}
                  </div>

                  <h3>{project.title}</h3>

                  <p>{project.description}</p>

                  <div class="tags">
                    {project.technologies.map((technology) => (
                      <span>{technology}</span>
                    ))}
                  </div>

                  <a href="#contact" class="project-link">
                    View case study →
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills" class="section">
        <div class="container">
          <p class="section-label">03 / TECHNICAL SKILLS</p>

          <h2>Tools I work with.</h2>

          <div class="skills-grid">
            <div>
              <span>01</span>
              <h3>Data Engineering</h3>
              <p>ETL · Data Pipelines · Data Warehousing</p>
            </div>

            <div>
              <span>02</span>
              <h3>Databases</h3>
              <p>SQL · Relational Databases · Data Modeling</p>
            </div>

            <div>
              <span>03</span>
              <h3>Programming</h3>
              <p>Python · Scripting · Data Processing</p>
            </div>

            <div>
              <span>04</span>
              <h3>Analytics</h3>
              <p>Business Intelligence · Dashboards · Reporting</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="contact-section">
        <div class="container contact-content">
          <p class="section-label">04 / CONTACT</p>

          <h2>Let's build something with data.</h2>

          <p>
            Interested in data engineering, analytics or technology
            opportunities? I'd be happy to connect.
          </p>

          <a
            href="mailto:YOUR_EMAIL@example.com"
            class="button primary"
          >
            Get In Touch →
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© 2026 Chetan Mylapilli</span>

        <span>Built with Astro · Hosted on GitHub Pages</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #071018;
    color: #e7edf5;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid #1c2a36;
    background: rgba(7, 16, 24, 0.9);
    backdrop-filter: blur(16px);
  }

  .nav-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .logo span {
    color: #38bdf8;
  }

  nav {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: #9aa9b8;
  }

  nav a:hover {
    color: #ffffff;
  }

  .hero {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid #1c2a36;
    background:
      radial-gradient(circle at 75% 30%, rgba(14, 165, 233, 0.13), transparent 35%),
      #071018;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
    padding: 100px 0;
  }

  .eyebrow,
  .section-label {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 20px 0;
    max-width: 760px;
    font-size: clamp(48px, 7vw, 82px);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  h1 span {
    color: #38bdf8;
  }

  .hero-description {
    max-width: 650px;
    color: #9aa9b8;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    margin: 32px 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
  }

  .primary {
    background: #38bdf8;
    color: #041019;
  }

  .secondary {
    border: 1px solid #334554;
    color: #d9e4ed;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .tech-row span,
  .tags span {
    border: 1px solid #263847;
    background: #0b1721;
    color: #9fb0bf;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 12px;
  }

  .hero-card {
    border: 1px solid #263847;
    border-radius: 14px;
    background: #09151f;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .terminal-header {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 15px;
    border-bottom: 1px solid #263847;
  }

  .terminal-header span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #425361;
  }

  .terminal-body {
    padding: 28px;
    font-family: "SFMono-Regular", Consolas, monospace;
    line-height: 1.7;
    color: #d5e0e8;
  }

  .purple {
    color: #c084fc;
  }

  .green,
  .result {
    color: #4ade80;
  }

  .comment {
    color: #65798a;
  }

  .section {
    padding: 120px 0;
    border-bottom: 1px solid #1c2a36;
  }

  .two-column {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 100px;
  }

  h2 {
    margin: 14px 0 0;
    font-size: clamp(38px, 5vw, 58px);
    letter-spacing: -0.05em;
  }

  .about-text {
    color: #9aa9b8;
    font-size: 17px;
    line-height: 1.9;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 55px;
  }

  .section-heading > p {
    max-width: 430px;
    color: #899aa9;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .project-card {
    min-height: 380px;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid #263847;
    border-radius: 12px;
    background: #09151f;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: #38bdf8;
  }

  .project-number {
    color: #38bdf8;
    font-family: monospace;
    font-size: 13px;
  }

  .project-card h3 {
    margin: 60px 0 15px;
    font-size: 24px;
  }

  .project-card p {
    color: #899aa9;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding: 25px 0;
  }

  .project-link {
    color: #38bdf8;
    font-size: 14px;
    font-weight: 700;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: 55px;
    border: 1px solid #263847;
  }

  .skills-grid > div {
    min-height: 200px;
    padding: 25px;
    background: #09151f;
    border-right: 1px solid #263847;
  }

  .skills-grid span {
    color: #38bdf8;
    font-family: monospace;
  }

  .skills-grid h3 {
    margin-top: 55px;
  }

  .skills-grid p {
    color: #899aa9;
    line-height: 1.6;
  }

  .contact-section {
    padding: 150px 0;
    text-align: center;
  }

  .contact-content {
    max-width: 800px;
  }

  .contact-section h2 {
    margin-bottom: 25px;
  }

  .contact-section p:not(.section-label) {
    color: #899aa9;
    line-height: 1.8;
    margin-bottom: 35px;
  }

  footer {
    border-top: 1px solid #1c2a36;
    color: #718292;
    font-size: 12px;
  }

  .footer-inner {
    min-height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  @media (max-width: 850px) {
    nav {
      display: none;
    }

    .hero-grid,
    .two-column {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr 1fr;
    }

    .section-heading {
      display: block;
    }
  }

  @media (max-width: 550px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    .hero-grid {
      padding: 70px 0;
    }

    h1 {
      font-size: 48px;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid > div {
      border-right: 0;
      border-bottom: 1px solid #263847;
    }

    .footer-inner {
      flex-direction: column;
      justify-content: center;
      padding: 25px 0;
    }
  }
</style>